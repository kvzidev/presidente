---
import { useTranslations, type Locale } from '../../i18n/ui';
import ContactModal from '../react/ContactModal';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const proposalsHref = lang === 'es-AR' ? '/propuestas' : '/en/proposals';
const blogHref      = lang === 'es-AR' ? '/haciendo-historia' : '/en/making-history';
const teamHref      = lang === 'es-AR' ? '/equipo' : '/en/team';

const modalStrings = {
  open:         t('contact.open'),
  title:        t('contact.title'),
  lead:         t('contact.lead'),
  nameLbl:      t('contact.name.label'),
  emailLbl:     t('contact.email.label'),
  msgLbl:       t('contact.msg.label'),
  submit:       t('contact.submit'),
  sending:      t('contact.sending'),
  success:      t('contact.success'),
  error:        t('contact.error'),
  close:        t('contact.close'),
  required:     t('contact.required'),
  emailInvalid: t('contact.email_invalid'),
};
---

<header class="header" role="banner" id="site-header">
  <div class="container header__inner">
    <a href={lang === 'es-AR' ? '/' : '/en/'} class="header__logo" aria-label={`${t('hero.name')} — ${lang === 'es-AR' ? 'inicio' : 'home'}`}>
      <span class="logo__initials" aria-hidden="true">{(t('hero.first_name')?.[0] || '') + (t('hero.last_name')?.[0] || '')}</span>
      <span class="logo__name">{t('hero.name')}</span>
    </a>

    <nav class="header__nav" aria-label={lang === 'es-AR' ? 'Navegación principal' : 'Main navigation'}>
      <ul role="list">
        <li><a href={proposalsHref} class="nav__link">{t('nav.proposals')}</a></li>
        <li><a href={blogHref}      class="nav__link">{t('nav.blog')}</a></li>
        <li><a href={teamHref}      class="nav__link">{t('nav.team')}</a></li>
        <li>
          <ContactModal
            client:load
            lang={lang}
            strings={modalStrings}
          />
        </li>
      </ul>
    </nav>

    <button
      class="burger"
      id="burger-btn"
      type="button"
      aria-controls="mobile-menu"
      aria-expanded="false"
      aria-label={t('nav.open_menu')}
    >
      <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true" focusable="false">
        <rect class="burger__line burger__line--top"    x="2" y="4"  width="18" height="2" rx="1" fill="currentColor"/>
        <rect class="burger__line burger__line--mid"    x="2" y="10" width="18" height="2" rx="1" fill="currentColor"/>
        <rect class="burger__line burger__line--bottom" x="2" y="16" width="18" height="2" rx="1" fill="currentColor"/>
      </svg>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" role="dialog" aria-modal="false" aria-label={lang === 'es-AR' ? 'Menú' : 'Menu'} hidden>
    <nav>
      <ul role="list">
        <li><a href={proposalsHref} class="mobile-menu__link">{t('nav.proposals')}</a></li>
        <li><a href={blogHref}      class="mobile-menu__link">{t('nav.blog')}</a></li>
        <li><a href={teamHref}      class="mobile-menu__link">{t('nav.team')}</a></li>
        <li class="mobile-contact">
          <ContactModal client:load lang={lang} strings={modalStrings} />
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  function initMenu() {
    const btn  = document.getElementById('burger-btn') as HTMLButtonElement;
    const menu = document.getElementById('mobile-menu') as HTMLElement;
    if (!btn || !menu) return;
    let isOpen = false;

    function openMenu() {
      isOpen = true;
      menu.removeAttribute('hidden');
      btn.setAttribute('aria-expanded', 'true');
      btn.classList.add('burger--open');
      (menu.querySelector<HTMLElement>('a'))?.focus();
    }
    function closeMenu() {
      isOpen = false;
      menu.setAttribute('hidden', '');
      btn.setAttribute('aria-expanded', 'false');
      btn.classList.remove('burger--open');
      btn.focus();
    }

    btn.addEventListener('click', () => isOpen ? closeMenu() : openMenu());
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && isOpen) closeMenu(); });
    menu.querySelectorAll('a').forEach(l => l.addEventListener('click', closeMenu));
  }

  initMenu();
  document.addEventListener('astro:page-load', initMenu);
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: oklch(98.5% 0.003 290 / 0.88);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border);
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    height: var(--nav-height);
  }

  .header__logo {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    text-decoration: none;
    flex-shrink: 0;
  }

  .logo__initials {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-sm);
    background: var(--primary);
    color: var(--primary-dark);
    font-family: 'Clash Display', sans-serif;
    font-weight: 700;
    font-size: var(--text-sm);
    letter-spacing: 0.05em;
    flex-shrink: 0;
  }

  .logo__name {
    font-family: 'Clash Display', sans-serif;
    font-weight: 600;
    font-size: var(--text-base);
    color: var(--text);
    @media (max-width: 30rem) { display: none; }
  }

  .header__nav {
    flex: 1;
    display: flex;
    justify-content: end;
    @media (max-width: 48rem) { display: none; }

    ul { display: flex; list-style: none; gap: var(--space-xs); align-items: center; }
  }

  .nav__link {
    display: inline-block;
    padding: 0.45rem 0.9rem;
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--transition-fast), background var(--transition-fast);

    &:hover { color: var(--text); background: var(--surface); }
  }

  .burger {
    display: none;
    background: none;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.5rem;
    cursor: pointer;
    color: var(--text);
    min-width: 2.75rem;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    transition: background var(--transition-fast);
    margin-inline-start: auto;

    &:hover { background: var(--surface); }
    @media (max-width: 48rem) { display: flex; }
  }

  .burger__line {
    transform-origin: center;
    transition: transform var(--transition-base), opacity var(--transition-base);
  }
  .burger--open {
    .burger__line--top    { transform: translateY(6px) rotate(45deg); }
    .burger__line--mid    { opacity: 0; }
    .burger__line--bottom { transform: translateY(-6px) rotate(-45deg); }
  }

  .mobile-menu {
    position: absolute;
    top: var(--nav-height);
    inset-inline: 0;
    background: var(--surface-raised);
    border-bottom: 1px solid var(--border);
    padding: var(--space-md);
    box-shadow: var(--shadow-lg);
    ul { list-style: none; }
  }

  .mobile-menu__link {
    display: flex;
    align-items: center;
    padding: var(--space-md);
    font-size: var(--text-lg);
    font-weight: 500;
    color: var(--text);
    text-decoration: none;
    border-radius: var(--radius-md);
    min-height: 2.75rem;
    transition: background var(--transition-fast);
    &:hover { background: var(--surface); }
  }

  /* Mobile contact trigger */
  .mobile-contact {
    padding: var(--space-sm) var(--space-md);
  }

  .mobile-contact .cm-trigger {
    width: 100%;
    justify-content: center;
    font-size: var(--text-lg);
    padding: var(--space-md);
    border-radius: var(--radius-md);
  }
</style>
