---
import { useTranslations, type Locale } from '../../i18n/ui';

interface Props { lang: Locale; }
const { lang } = Astro.props;
const t = useTranslations(lang);

const proposalsHref = lang === 'es-AR' ? '/propuestas'    : '/en/proposals';
const visionHref    = lang === 'es-AR' ? '/argentina-2035' : '/en/argentina-2035';
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="container hero__inner">
    <div class="hero__content">
      <p class="hero__badge" aria-label={t('hero.badge')}>
        <span aria-hidden="true">
          <svg width="8" height="8" viewBox="0 0 8 8">
            <circle cx="4" cy="4" r="4" fill="currentColor"/>
          </svg>
        </span>
        {t('hero.badge')}
      </p>

      <h1 id="hero-heading" class="hero__name"><span>{t('hero.first_name')}</span><span>{t('hero.last_name')}</span></h1>
      <p class="hero__slogan">{t('hero.slogan')}</p>
      <p class="hero__subtitle">{t('hero.subtitle')}</p>

      <nav class="hero__actions" aria-label={lang === 'es-AR' ? 'Acciones principales' : 'Main actions'}>
        <a href={proposalsHref} class="hero__cta hero__cta--primary">
          {t('hero.cta_proposals')}
        </a>
        <a href={visionHref} class="hero__cta hero__cta--secondary">
          {t('hero.cta_vision')}
        </a>
      </nav>
    </div>

    <div class="hero__portrait-wrap">
      <img
        src="/candidate.png"
        alt={t('hero.portrait_alt')}
        class="hero__portrait"
        width="480"
        height="480"
        loading="eager"
        decoding="async"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: calc(100dvh - var(--nav-height));
    display: grid;
    align-items: center;
    padding-block: clamp(3rem, 8vw, 6rem);
    overflow: hidden;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;

    @media (max-width: 52rem) {
      grid-template-columns: 1fr;
      text-align: center;
      .hero__content { order: 2; }
      .hero__portrait-wrap { order: 1; }
    }
  }

  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--secondary);
    color: var(--secondary-dark);
    font-size: var(--text-sm);
    font-weight: 600;
    padding: 0.3rem 0.9rem;
    border-radius: var(--radius-full);
    margin-bottom: var(--space-lg);
    max-width: none;

    svg { flex-shrink: 0; }
  }

  .hero__name {
    display: flex;
    flex-direction: column;
    color: var(--text);
    margin-bottom: var(--space-md);
    letter-spacing: -0.02em;

    @media (max-width: 52rem) {
      flex-direction: row;
      justify-content: center;
      gap: 1rem;
    }

    span {
      &:last-child {
        align-self: flex-end;
      }
    }
  }

  .hero__slogan {
    font-family: 'Clash Display', sans-serif;
    font-size: clamp(1.4rem, 4vw, 2.2rem);
    font-weight: 500;
    color: var(--primary-dark);
    margin-bottom: var(--space-lg);
    /*max-width: 22ch;*/
    line-height: 1.3;

    @media (max-width: 52rem) {
      width: 100%;
      text-align: center;
    }
  }

  .hero__subtitle {
    font-size: var(--text-lg);
    color: var(--text-muted);
    margin-bottom: var(--space-xl);
    max-width: 44ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);

    @media (max-width: 52rem) { justify-content: center; }
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    font-weight: 600;
    font-size: var(--text-base);
    padding: 0.8rem 1.75rem;
    border-radius: var(--radius-full);
    text-decoration: none;
    min-height: 2.75rem;
    transition: transform var(--transition-fluid), box-shadow var(--transition-base);

    &:hover { transform: translateY(-2px) scale(1.02); }

    &--primary {
      background: var(--primary-dark);
      color: var(--bg);
      box-shadow: 0 4px 14px oklch(48% 0.12 305 / 0.35);
    }

    &--secondary {
      background: var(--primary);
      color: var(--primary-dark);
    }
  }

  /* Portrait: no crop border, gradient mask to fade into page bg */
  .hero__portrait-wrap {
    display: flex;
    justify-content: center;
    position: relative;
  }

  .hero__portrait {
    width: clamp(16rem, 40vw, 26rem);/**/
    height: clamp(16rem, 40vw, 26rem);/**/
    object-fit: cover;
    object-position: top center;
    border-radius: var(--radius-xl);/**/
    /* Gradient mask: full at top, transparent at bottom — blends into page bg naturally */
    mask-image: radial-gradient(
      circle at center,
      black 45%,
      transparent 100%
    );
    -webkit-mask-image: radial-gradient(
      circle at center,
      black 45%,
      transparent 100%
    );
  }
</style>
