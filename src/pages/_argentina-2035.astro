---
import BaseLayout from '../layouts/BaseLayout.astro';
import Vision from '../components/sections/Vision.astro';
import { useTranslations, type Locale } from '../i18n/ui';

const lang: Locale = 'es-AR';
const t = useTranslations(lang);
---

<BaseLayout
  lang={lang}
  altUrl="/en/argentina-2035"
  title={`${t('nav.vision')} — ${t('hero.name')}`}
  description={`La visión de ${t('hero.name')} para Argentina en 2035: un plan con hitos verificables del 2027 al 2035.`}
>
  <Vision lang={lang} />
</BaseLayout>
