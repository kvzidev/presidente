---
import BaseLayout from '../layouts/BaseLayout.astro';
import Proposals from '../components/sections/Proposals.astro';
import { useTranslations, type Locale } from '../i18n/ui';

const lang: Locale = 'es-AR';
const t = useTranslations(lang);
---

<BaseLayout
  lang={lang}
  altUrl="/en/proposals"
  title={`${t('proposals.title')} — ${t('hero.name')} ${t('hero.year')}`}
  description={`Las propuestas de ${t('hero.name')} para las elecciones presidenciales argentinas ${t('hero.year')}. Tecnología, educación, salud y estado.`}
>
  <Proposals lang={lang} />
</BaseLayout>
