---
import BaseLayout from '../layouts/BaseLayout.astro';
import Team from '../components/sections/Team.astro';
import { useTranslations, type Locale } from '../i18n/ui';

const lang: Locale = 'es-AR';
const t = useTranslations(lang);
---

<BaseLayout
  lang={lang}
  altUrl="/en/team"
  title={`${t('team.title')} — ${t('hero.name')} 2027`}
  description={`Conocé a las personas que acompañan a ${t('hero.name')} en su candidatura presidencial para 2027.`}
>
  <Team lang={lang} />
</BaseLayout>
