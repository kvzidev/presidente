---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Stories from '../../../components/sections/Stories.astro';
import { useTranslations, type Locale } from '../../../i18n/ui';

const lang: Locale = 'en';
const t = useTranslations(lang);
---

<BaseLayout
  lang={lang}
  altUrl="/haciendo-historia"
  title={`${t('blog.title')} — ${t('hero.name')} ${t('hero.year')}`}
  description={`Stories, success cases, and challenges in the application of methodology in public management with ${t('hero.name')}.`}
>
  <Stories lang={lang} />
</BaseLayout>
