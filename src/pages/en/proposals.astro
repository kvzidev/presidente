---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProposalsSection from '../../components/sections/Proposals.astro';
import { useTranslations, type Locale } from '../../i18n/ui';

const lang: Locale = 'en';
const t = useTranslations(lang);
---

<BaseLayout
  lang={lang}
  altUrl="/propuestas"
  title={`${t('proposals.title')} — ${t('hero.name')} ${t('hero.year')}`}
  description={`${t('hero.name')}'s proposals for the ${t('hero.year')} Argentine presidential elections. Technology, education, health and state.`}
>
  <ProposalsSection lang={lang} />
</BaseLayout>
